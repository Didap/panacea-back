NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgres://panacea_admin:panacea_admin@localhost:5433/panacea
DATABASE_APP_USER=panacea_app
DATABASE_APP_PASSWORD=panacea_app

JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_32_chars_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_REFRESH_TTL=7d

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/documents

# When STORAGE_DRIVER=r2:
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_KMS_KEY_ID=

CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=10
LOGIN_LOCKOUT_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_DURATION_MIN=15

PUBLIC_WEB_BASE_URL=http://localhost:5173

# console prints emails to the log in dev; switch to resend in prod once the key below is set.
NOTIFICATIONS_DRIVER=console
NOTIFICATIONS_FROM=Panacea <noreply@panacea.local>
# Placeholder: paste the real Resend API key here and set NOTIFICATIONS_DRIVER=resend.
RESEND_API_KEY=replace_me_with_resend_api_key

INVITATION_TTL_DAYS=7
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
# Set to true in prod to refuse login until the email is verified.
REQUIRE_EMAIL_VERIFICATION=false
